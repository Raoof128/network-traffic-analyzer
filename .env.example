# Network Traffic Analyzer - Environment Variables
# Copy this file to .env and configure for your environment

# Network Interface
INTERFACE=eth0

# Email Configuration (for alerts)
NTA_EMAIL_PASSWORD=your_smtp_password_here
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER=alerts@example.com
SMTP_RECIPIENTS=admin@example.com

# Webhook Configuration
WEBHOOK_URL=https://hooks.example.com/alerts
WEBHOOK_METHOD=POST

# API Configuration
API_PORT=8000
API_WORKERS=4
API_HOST=0.0.0.0

# Dashboard Configuration
DASHBOARD_PORT=8080
DASHBOARD_HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/analyzer.log

# Directories
PCAP_DIR=./data/pcaps
MODEL_DIR=./models/trained_models
DATA_DIR=./data
REPORTS_DIR=./reports

# Model Configuration
MODEL_TYPE=isolation_forest
CONTAMINATION=0.1
N_ESTIMATORS=200

# Alert Configuration
ALERT_MIN_SEVERITY=LOW
ALERT_RATE_LIMIT=100

# Performance
CACHE_MAXSIZE=1000
CACHE_TTL=300

# Database (optional - for future use)
# DATABASE_URL=postgresql://user:password@localhost:5432/nta
# REDIS_URL=redis://localhost:6379/0

# Security
# SECRET_KEY=your_secret_key_here  # For HMAC signing of pickle files
