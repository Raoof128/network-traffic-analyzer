# Git attributes for consistent line endings across platforms
# https://git-scm.com/docs/gitattributes

# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Source code
*.py text eol=lf
*.pyx text eol=lf
*.pyi text eol=lf
*.pyw text eol=lf

# Scripts
*.sh text eol=lf
*.bash text eol=lf
*.fish text eol=lf
*.zsh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=lf

# Configuration files
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.config text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf
*.adoc text eol=lf
LICENSE text eol=lf
AUTHORS text eol=lf
CHANGELOG text eol=lf
CONTRIBUTING text eol=lf
README text eol=lf

# Docker files
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
.dockerignore text eol=lf

# Git files
.gitignore text eol=lf
.gitattributes text eol=lf
.gitmodules text eol=lf

# CI/CD
.travis.yml text eol=lf
.gitlab-ci.yml text eol=lf
Jenkinsfile text eol=lf

# Web files
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf

# Data files
*.csv text eol=lf
*.tsv text eol=lf
*.sql text eol=lf

# Binary files (explicitly marked)
*.pkl binary
*.pickle binary
*.pyc binary
*.pyo binary
*.pyd binary
*.so binary
*.dll binary
*.exe binary
*.dylib binary
*.a binary
*.lib binary
*.o binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.webp binary
*.bmp binary
*.tiff binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.xz binary
*.7z binary
*.rar binary

# Network capture files
*.pcap binary
*.pcapng binary
*.cap binary

# Database files
*.db binary
*.sqlite binary
*.sqlite3 binary

# Model files
*.h5 binary
*.hdf5 binary
*.joblib binary
*.model binary

# Other binary formats
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Diffs for specific file types
*.py diff=python
*.md diff=markdown
*.json diff=json

# Export ignore (files not included in exports/archives)
.gitattributes export-ignore
.gitignore export-ignore
.editorconfig export-ignore
.travis.yml export-ignore
.gitlab-ci.yml export-ignore
Jenkinsfile export-ignore
/tests export-ignore
/docs export-ignore
/examples export-ignore
*.test.py export-ignore
test_* export-ignore
.github export-ignore
.pre-commit-config.yaml export-ignore

# Linguist (GitHub language detection)
*.ipynb linguist-documentation
examples/* linguist-documentation
docs/* linguist-documentation
